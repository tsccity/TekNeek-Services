---
const { title = 'TekNeek Services', current = '', description = 'Custom apparel, personalized gifts, and technology solutions in West Texas.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://tekneekservices.com').href;
const socialImage = 'https://tekneekservices.com/assets/tekneek-t.png';
const structuredData = {'@context':'https://schema.org','@type':'Organization',name:'TekNeek Services LLC',url:'https://tekneekservices.com/',logo:socialImage,email:'office@tekneekservices.com',telephone:'+1-325-644-8720',description:'Custom apparel, personalized engraved gifts, and business technology services based in Colorado City, Texas.',address:{'@type':'PostalAddress',addressLocality:'Colorado City',addressRegion:'TX',addressCountry:'US'},sameAs:['https://www.facebook.com/TekNeekServices','https://popl.co/profile/zNKn8G8T']};
const links = [['/','Home'],['/tops-tees/','Tops & Tees'],['/creative/','Creative'],['/digital/','Digital'],['/connect/','Connect'],['/contact/','Contact']];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content={description}><meta name="theme-color" content="#101214"><title>{title}</title><link rel="canonical" href={canonical}><meta property="og:type" content="website"><meta property="og:site_name" content="TekNeek Services"><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:url" content={canonical}><meta property="og:image" content={socialImage}><meta property="og:image:alt" content="TekNeek Services metallic T emblem"><meta name="twitter:card" content="summary"><meta name="twitter:title" content={title}><meta name="twitter:description" content={description}><link rel="sitemap" type="application/xml" href="/sitemap.xml"><script type="application/ld+json" set:html={JSON.stringify(structuredData)} /><link rel="stylesheet" href="/styles/style.css"></head>
<body>
<header class="nav"><a class="brand" href="/"><img src="/assets/tekneek-t.png" alt="TekNeek metallic T emblem"><span>TekNeek<small>SERVICES</small></span></a><nav class="desktop-nav" aria-label="Main navigation">{links.map(([url,label])=><a href={url} aria-current={current===url?'page':undefined}>{label}</a>)}</nav><a class="nav-cta desktop-cta" href="https://m.me/TekNeekServices" target="_blank" rel="noopener noreferrer">Message Me</a><div class="mobile-nav"><a class="mobile-contact" href="/contact/">Contact</a><details class="mobile-menu"><summary aria-label="Open navigation menu"><span class="menu-lines" aria-hidden="true"><span></span><span></span><span></span></span><span>Menu</span></summary><nav aria-label="Mobile navigation">{links.map(([url,label])=><a href={url} aria-current={current===url?'page':undefined}>{label}</a>)}</nav></details></div></header>
<main><slot /></main><footer>© TekNeek Services LLC · Custom. Creative. Connected. · <a href="/contact/">Contact</a></footer>
</body></html>