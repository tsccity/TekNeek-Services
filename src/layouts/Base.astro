---
const { title = 'TekNeek Services', current = '', description = 'Custom apparel, personalized gifts, and technology solutions in West Texas.' } = Astro.props;
const links = [['/','Home'],['/tops-tees/','Tops & Tees'],['/creative/','Creative'],['/digital/','Digital'],['/connect/','Connect'],['/contact/','Contact']];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content={description}><meta name="theme-color" content="#101214"><title>{title}</title><link rel="stylesheet" href="/styles/style.css"></head>
<body>
<header class="nav"><a class="brand" href="/"><img src="/assets/tekneek-t.png" alt="TekNeek metallic T emblem"><span>TekNeek<small>SERVICES</small></span></a><nav aria-label="Main navigation">{links.map(([url,label])=><a href={url} aria-current={current===url?'page':undefined}>{label}</a>)}</nav><a class="nav-cta" href="https://m.me/TekNeekServices" target="_blank" rel="noopener noreferrer">Message Me</a></header>
<main><slot /></main><footer>© TekNeek Services LLC · Custom. Creative. Connected. · <a href="/contact/">Contact</a></footer>
</body></html>