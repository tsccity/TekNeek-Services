---
import Base from '../layouts/Base.astro';
import gallery from '../data/tops-tees-gallery.json';
---
<Base title="Custom Hats & Shirts in Colorado City, TX | TekNeek Tops & Tees" description="Custom patch hats, T-shirts and apparel for businesses, teams, events and individuals in West Texas. View our work and request a personalized quote." current="/tops-tees/">
<section class="subhero"><p class="eyebrow">TEKNEEK TOPS &amp; TEES</p><h1>Custom apparel. Made personal.</h1></section>
<section class="wrap">
  <p class="lede">Custom hats, shirts, and apparel for individuals, businesses, teams, and events. See what we've made, then tell us what you have in mind.</p>
  <div class="features">
    <article><h2>Custom Patch Hats</h2><p>Trucker caps, classic hats, leatherette patches, and other custom headwear. We'll help you choose the right style, colors, and patch for your project.</p><p><strong>Starting at $32 per hat.</strong> Quantity and premium options affect the final quote.</p></article>
    <article><h2>Custom T-Shirts &amp; Apparel</h2><p>Everyday tees, performance shirts, business apparel, and team orders. Share your design or describe your idea.</p><p><strong>T-shirts starting at $24.</strong> Garment, print size, and quantity affect pricing.</p></article>
  </div>
  <h2>See what we've made</h2>
  <div class="project-gallery">{gallery.items.map(item => <article class="project-card"><img src={item.image} alt={item.title} loading="lazy" /><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div>
  <div class="studio-banner">
    <h2>Let's make something for you.</h2>
    <p>Send us the item or style you're interested in, quantity, sizes or colors, your artwork or idea, and any deadline. We'll follow up with options and a personalized quote.</p>
    <div class="actions">
      <a class="btn primary" href="https://m.me/TekNeekServices" target="_blank" rel="noopener noreferrer">Message Us on Facebook ↗</a>
      <a class="btn dark" href="mailto:office@tekneekservices.com?subject=TekNeek%20Tops%20%26%20Tees%20-%20Quote%20Request&amp;body=Product%20or%20style%3A%0AQuantity%3A%0ASizes%20and%20colors%3A%0ADesign%20or%20personalization%3A%0ARequested%20date%3A%0A">Request a Quote by Email →</a>
    </div>
  </div>
</section>
</Base>