import Base from '../layouts/Base.astro';
import gallery from '../data/tops-tees-gallery.json';
---
<Base title="Custom Hats & Shirts in Colorado City, TX | TekNeek Tops & Tees" description="Personalized patch hats, custom shirts and apparel for businesses, teams, events and individuals in Colorado City and West Texas. Ask TekNeek about your design." current="/tops-tees/"><section class="subhero"><p class="eyebrow">TEKNEEK TOPS &amp; TEES</p><h1>Custom apparel. Made personal.</h1></section><section class="wrap"><p class="lede">Custom hats, shirts, and apparel for individuals, businesses, teams, and events. Your idea. Your style. Made personal.</p><div class="studio-banner"><h2>Design your own patch hat.</h2><p>Try our interactive mockup studio and request a personalized quote.</p><a class="btn primary" href="/hat-studio/">Open Hat Studio →</a></div><div class="project-gallery">{gallery.items.map(item => <article class="project-card"><img src={item.image} alt={item.title} loading="lazy" /><div><h3>{item.title}</h3><p>{item.description}</p></div></article>)}</div><div class="features"><article><h3>Custom Patch Hats</h3><p>Personalized headwear with patches and designs tailored to your project.</p></article><article><h3>Shirts &amp; Apparel</h3><p>Custom apparel for individuals, teams, events, and businesses.</p></article></div><a class="btn dark" href="https://m.me/TekNeekServices" target="_blank" rel="noopener noreferrer">Discuss an apparel order ↗</a></section></Base>