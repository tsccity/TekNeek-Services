---
import Base from '../layouts/Base.astro';
import home from '../data/home.json';
---
<Base title="TekNeek Services | Custom Apparel, Gifts & IT in Colorado City, TX" description="TekNeek Services in Colorado City, Texas creates personalized hats, custom shirts, engraved gifts, and provides business IT and backup internet services across West Texas." current="/">
<section class="hero"><div><p class="eyebrow">TEKNEEK SERVICES LLC · COLORADO CITY, TEXAS</p><h1>Custom.<br><em>Creative.</em><br>Connected.</h1><p class="intro">{home.intro}</p><p class="tagline">Stand Out. Stay Connected.</p><div class="actions"><a class="btn primary" href="https://m.me/TekNeekServices" target="_blank" rel="noopener noreferrer">Message Me on Facebook ↗</a><a class="btn secondary" href="sms:+13256448720">Send a Text</a></div><p class="small">Or <a href="tel:+13256448720">call (325) 644-8720</a> · <a href="mailto:office@tekneekservices.com">email me</a></p></div><img class="hero-logo" src="/assets/tekneek-t.png" alt="TekNeek metallic T emblem" fetchpriority="high" decoding="async"></section>
<section class="wrap"><p class="eyebrow">WHAT WE DO</p><h2>One company. Three specialties.</h2><p class="lede">{home.servicesIntro}</p><div class="cards"><article class="card"><img src="/assets/tekneek-custom-richardson-patch-hats.webp" alt="Custom Richardson trucker hats with personalized leatherette patches" loading="lazy" decoding="async" width="1254" height="1254"><div class="card-copy"><span class="number">01 / CUSTOM</span><h3>Tops &amp; Tees</h3><p>Custom hats, shirts, and apparel for individuals, businesses, teams, and events.</p><a href="/tops-tees/">Explore Tops &amp; Tees →</a></div></article><article class="card"><img src="/assets/tekneek-personalized-engraved-tumblers.webp" alt="Personalized engraved tumblers made by TekNeek Creative" loading="lazy" decoding="async" width="1600" height="1205"><div class="card-copy"><span class="number">02 / CREATIVE</span><h3>Creative</h3><p>Engraved gifts, keepsakes, awards, and custom creations.</p><a href="/creative/">Explore Creative →</a></div></article><article class="card"><img src="/assets/tekneek-connect-backup-internet.webp" alt="TekNeek Connect managed backup internet for West Texas businesses" loading="lazy" decoding="async" width="1253" height="1060"><div class="card-copy"><span class="number">03 / CONNECTED</span><h3>Digital</h3><p>Computer support, networking, business IT, and managed backup internet.</p><a href="/digital/">Explore Digital →</a></div></article></div></section>

<section class="contact-strip"><h2>Let Me Know How I Can Help.</h2><p>{home.contactIntro}</p><div class="actions center"><a class="btn primary" href="https://m.me/TekNeekServices" target="_blank" rel="noopener noreferrer">Facebook Messenger ↗</a><a class="btn secondary" href="sms:+13256448720">Text Me</a><a class="btn secondary" href="tel:+13256448720">Call Me</a><a class="btn secondary" href="mailto:office@tekneekservices.com">Email Me</a></div></section>
</Base>