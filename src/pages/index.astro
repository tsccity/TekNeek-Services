---
import Base from '../layouts/Base.astro';
import home from '../data/home.json';
---
<Base title="TekNeek Services | Custom. Creative. Connected." current="/">
<section class="hero"><div><p class="eyebrow">TEKNEEK SERVICES LLC · WEST TEXAS</p><h1>Custom.<br><em>Creative.</em><br>Connected.</h1><p class="intro">{home.intro}</p><p class="tagline">Stand Out. Stay Connected.</p><div class="actions"><a class="btn primary" href="https://m.me/TekNeekServices" target="_blank" rel="noopener noreferrer">Message Me on Facebook ↗</a><a class="btn secondary" href="sms:+13256448720">Send a Text</a></div><p class="small">Or <a href="tel:+13256448720">call (325) 644-8720</a> · <a href="mailto:office@tekneekservices.com">email me</a></p></div><img class="hero-logo" src="/assets/tekneek-t.png" alt="TekNeek metallic T emblem"></section>
<section class="wrap"><p class="eyebrow">WHAT WE DO</p><h2>One company. Three specialties.</h2><p class="lede">{home.servicesIntro}</p><div class="cards"><article class="card"><img src="/assets/hat.png" alt="Custom patch hat by TekNeek"><div class="card-copy"><span class="number">01 / CUSTOM</span><h3>Tops &amp; Tees</h3><p>Custom hats, shirts, and apparel for individuals, businesses, teams, and events.</p><a href="/tops-tees/">Explore Tops &amp; Tees →</a></div></article><article class="card"><div class="placeholder">PERSONALIZED<br>WITH PURPOSE</div><div class="card-copy"><span class="number">02 / CREATIVE</span><h3>Creative</h3><p>Engraved gifts, keepsakes, awards, and custom creations.</p><a href="/creative/">Explore Creative →</a></div></article><article class="card"><div class="placeholder digital">CONNECTED<br>WITH CONFIDENCE</div><div class="card-copy"><span class="number">03 / CONNECTED</span><h3>Digital</h3><p>Computer support, networking, business IT, and managed backup internet.</p><a href="/digital/">Explore Digital →</a></div></article></div></section>
<section class="section-alt"><div class="wrap"><p class="eyebrow">MANAGED BACKUP INTERNET</p><h2>Meet TekNeek Connect.</h2><p class="lede">Cellular backup internet to help keep essential business operations connected when primary service fails.</p><a class="btn primary" href="/connect/">Learn About Connect →</a></div></section>
<section class="wrap"><p class="eyebrow">MADE BY TEKNEEK</p><h2>{home.workHeading}</h2><div class="gallery"><img src="/assets/hat.png" alt="Custom patch hat"><img src="/assets/shirts.png" alt="Custom printed shirts"></div></section>
<section class="contact-strip"><h2>Let Me Know How I Can Help.</h2><p>{home.contactIntro}</p><div class="actions center"><a class="btn primary" href="https://m.me/TekNeekServices" target="_blank" rel="noopener noreferrer">Facebook Messenger ↗</a><a class="btn secondary" href="sms:+13256448720">Text Me</a><a class="btn secondary" href="tel:+13256448720">Call Me</a><a class="btn secondary" href="mailto:office@tekneekservices.com">Email Me</a></div></section>
</Base>