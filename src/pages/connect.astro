---
import Base from '../layouts/Base.astro';
import connect from '../data/connect.json';
---
<Base title="Managed Backup Internet for Businesses | TekNeek Connect" description="TekNeek Connect offers managed cellular backup internet, automatic failover and recovery, remote monitoring and network integration for eligible West Texas businesses." current="/connect/">
  <section class="subhero"><p class="eyebrow">TEKNEEK DIGITAL / CONNECT</p><h1>{connect.heading}</h1></section>
  <section class="wrap"><p class="lede">{connect.intro}</p><figure class="connect-showcase"><img src="/assets/tekneek-connect-backup-internet.webp" alt="TekNeek Connect promotional graphic explaining business internet outages and managed cellular backup service" width="1253" height="1060" loading="lazy" decoding="async"><figcaption>Managed backup connectivity for when your primary internet service fails. Contact TekNeek for current pricing and availability.</figcaption></figure><h2>How it works</h2>
    <div class="features">{connect.steps.map(step => <article><h3>{step.title}</h3><p>{step.description}</p></article>)}</div>
    <h2>{connect.businessHeading}</h2><p>{connect.businessDescription}</p>
    <div class="notice"><strong>Important:</strong> {connect.notice}</div>
    <p><a class="btn dark" href="https://m.me/TekNeekServices" target="_blank" rel="noopener noreferrer">Ask About TekNeek Connect ↗</a></p>
  </section>
</Base>
