---
import Base from '../layouts/Base.astro';
import connect from '../data/connect.json';
---
<Base title="Connect | TekNeek Services" current="/connect/">
  <section class="subhero"><p class="eyebrow">TEKNEEK DIGITAL / CONNECT</p><h1>{connect.heading}</h1></section>
  <section class="wrap"><p class="lede">{connect.intro}</p><h2>How it works</h2>
    <div class="features">{connect.steps.map(step => <article><h3>{step.title}</h3><p>{step.description}</p></article>)}</div>
    <h2>{connect.businessHeading}</h2><p>{connect.businessDescription}</p>
    <div class="notice"><strong>Important:</strong> {connect.notice}</div>
    <p><a class="btn dark" href="https://m.me/TekNeekServices" target="_blank" rel="noopener noreferrer">Ask About TekNeek Connect ↗</a></p>
  </section>
</Base>
