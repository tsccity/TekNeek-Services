---
import Base from '../../layouts/Base.astro';
---
<Base title="QuickShop | TekNeek Services" description="Shop local merchandise and fundraisers from TekNeek Services.">
<section class="shop"><p class="eyebrow">TEKNEEK QUICKSHOP</p><h1>Shop local. Support local.</h1><p>Local pickup through TekNeek Services.</p><p id="catalog-status" role="status">Loading products…</p><div id="catalog" class="products"></div></section>
<script>
import {loadCatalog} from '../../lib/quickshop-api';
const status=document.querySelector('#catalog-status')!;
const catalog=document.querySelector('#catalog')!;
async function start(){
try{
const products=await loadCatalog();
for(const p of products){
const card=document.createElement('article');card.className='product';
if(p.image_url){const image=document.createElement('img');image.src=p.image_url;image.alt=p.name;image.loading='lazy';card.append(image);}
const heading=document.createElement('h2');heading.textContent=p.name;card.append(heading);
const description=document.createElement('p');description.textContent=p.description??'';card.append(description);
const price=document.createElement('strong');price.textContent=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(p.price_cents/100);card.append(price);
if(p.slug==='wolves-baseball'){const link=document.createElement('a');link.className='btn primary';link.href='/shop/wolves-baseball/';link.textContent='View product';card.append(link);}
catalog.append(card);
}
status.textContent=products.length?'':'No products currently available.';
}catch{status.textContent='Unable to load products. Please try again later.';}
}
start();
</script>
<style is:global>.shop{max-width:1100px;margin:auto;padding:3rem 1.25rem}.shop .products{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:1rem;margin-top:2rem}.shop .product{border:1px solid #a7adb2;border-radius:12px;padding:1.5rem;display:grid;gap:1rem}.shop .product img{width:100%;height:auto;border-radius:8px}.shop .product strong{font-size:1.5rem}.shop .product a{justify-self:start}</style>
</Base>